# ------------------------------------------------------------------
# polybot 環境変数テンプレート。コピーして .env を作り、値を埋める。
# .env は絶対にコミットしない (.gitignore 済み)。秘密鍵はここにしか置かない。
# ------------------------------------------------------------------

# Polygon上のウォレット秘密鍵 (0x始まり)。Polymarket取引の署名に使う。
# 取引専用の新規ウォレットを使い、資金はKellyサイズが吐き出す想定額+αだけ入れること。
POLY_PRIVATE_KEY=

# 実際に発注する口座 (email/Magicログインならプロキシウォレットアドレス、
# メタマスク等の直接署名なら自分のアドレスと同じ)
POLY_FUNDER_ADDRESS=

# signature_type: 0=EOA直接, 1=email/Magicウォレット, 2=ブラウザウォレット(proxy)
# 分からなければPolymarketの Settings > API で確認する
POLY_SIGNATURE_TYPE=1

POLY_CLOB_HOST=https://clob.polymarket.com
POLY_CHAIN_ID=137

# 対象マーケットのシリーズ (5分足 or 1時間足)
POLY_SERIES_SLUG=btc-up-or-down-1h

# 参照価格フィード (Chainlink Data Streamsの近似。basisリスクの注意点はREADME参照)
REF_PRICE_SOURCE=binance
REF_PRICE_SYMBOL=BTCUSDT

# このエッジ(モデル確率 - 市場価格)を超えたときだけ発注する
EDGE_THRESHOLD=0.05

# Kelly基準の何倍賭けるか (1.0=フルKelly, 0.5=ハーフKelly)
# フルKellyはモデル誤差に対して非常に脆いことに注意 (README参照)
KELLY_FRACTION=1.0

# ポーリング間隔(秒)
POLL_INTERVAL_SECONDS=15

# false の間は一切発注せず、判断ログだけ出す (デフォルト推奨: まずここで検証する)
LIVE_TRADING=false

LOG_FILE=polybot.log
