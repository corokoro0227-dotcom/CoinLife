# どのデータソースを使うか: "x" (公式X API, 要有料枠) | "mock" (キー無しでパイプライン確認用)
SIGNAL_PROVIDER=mock

# X API v2 (https://developer.x.com/ で Basic以上のプランを契約し Bearer Token を取得)
X_BEARER_TOKEN=

# スキャン対象チェーン (カンマ区切り)
SCAN_CHAINS=solana,base,bnb,hyperevm,robinhood

# 各チェーンのJSON-RPCエンドポイント。空欄のチェーンは「未検証」として扱われる。
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
BASE_RPC_URL=https://mainnet.base.org
BNB_RPC_URL=https://bsc-dataseed.binance.org
HYPEREVM_RPC_URL=https://rpc.hyperliquid.xyz/evm
ROBINHOOD_RPC_URL=

# pump.fun の公開API(非公式、将来変更される可能性あり)。Solana新規ローンチの補助検証に使う。
PUMPFUN_API_BASE=https://frontend-api.pump.fun

# 通知先。空ならコンソール出力のみ。
NOTIFY_WEBHOOK_URL=
# "discord" | "slack" | "generic" — webhookのペイロード形式
NOTIFY_WEBHOOK_KIND=generic

# 1回のスキャンで返す最大コイン数
MAX_RESULTS=5

# watchモードでのスキャン間隔(分)
WATCH_INTERVAL_MINUTES=15
