# カンマ区切りのccxt取引所ID(swap/perpetual futuresに対応しているもの)
# 例: binance,bybit,okx,bitget,gateio
EXCHANGES=binance,bybit,okx

# 監視するBTC無期限先物のユニファイドシンボル(ccxt表記)
SYMBOL=BTC/USDT:USDT

# 単一の時間足(ccxtのtimeframe表記)
TIMEFRAME=15m

# RSI期間
RSI_PERIOD=14

# RSIしきい値(これ未満で条件成立)
RSI_THRESHOLD=30

# 出来高の比較に使う過去本数(直近の確定足を除く、この本数の平均と比較)
VOLUME_LOOKBACK=20

# 出来高の増加率のしきい値(2.0 = 平均比+100%、3.0 = 平均比+200%)
VOLUME_SPIKE_MULTIPLIER=3.0

# ポーリング間隔(秒)。新しい確定足をすぐ拾いたい場合は短めに(例: 60)
POLL_INTERVAL_SEC=60

# 同一取引所への再通知を抑制する間隔(秒)。例: 3600 = 1時間に1回まで
ALERT_COOLDOWN_SEC=3600

# --- 通知先(どちらか、または両方を設定) ---
# Discord Webhook URL
DISCORD_WEBHOOK_URL=

# Telegram Bot Token と 送信先chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
