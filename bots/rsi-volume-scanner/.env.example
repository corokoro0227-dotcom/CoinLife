# ccxt取引所ID(swap/perpetual futuresに対応しているもの)。単一取引所を指定
# 例: binance / bybit / okx / bitget / gateio
EXCHANGE=binance

# 監視するBTC無期限先物のユニファイドシンボル(ccxt表記)
SYMBOL=BTC/USDT:USDT

# エントリー判定に使う実行足(ccxtのtimeframe表記)
TIMEFRAME=15m

# RSI期間
RSI_PERIOD=14

# RSIしきい値(これ未満で条件成立)
RSI_THRESHOLD=30

# 出来高の比較に使う過去本数(直近の確定足を除く、この本数の平均と比較)
VOLUME_LOOKBACK=20

# 出来高の増加率のしきい値(2.0 = 平均比+100%、3.0 = 平均比+200%)
VOLUME_SPIKE_MULTIPLIER=3.0

# シグナル足自体が陽線(close>open)で閉じていることを追加条件にするか
# (「下げの最中」ではなく「反発し始めた足」に絞り込むための確認)
REQUIRE_BULLISH_CLOSE=true

# --- トレンドフィルタ(強い下降トレンド中の逆張りを避ける) ---
# トレンド判定に使う上位足(実行足より長い時間足を推奨)
TREND_TIMEFRAME=4h
# トレンド判定に使うEMA期間。実行足の終値がこのEMAより上のときだけシグナルを有効にする
TREND_EMA_PERIOD=200

# ポーリング間隔(秒)。新しい確定足をすぐ拾いたい場合は短めに(例: 60)
POLL_INTERVAL_SEC=60

# 再通知を抑制する間隔(秒)。例: 3600 = 1時間に1回まで
ALERT_COOLDOWN_SEC=3600

# --- 通知先(どちらか、または両方を設定) ---
# Discord Webhook URL
DISCORD_WEBHOOK_URL=

# Telegram Bot Token と 送信先chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
